+    static bool LooksLikeCrashUrl(string url)
+        => !string.IsNullOrWhiteSpace(url)
+           && (url.StartsWith("chrome-error://", StringComparison.OrdinalIgnoreCase)
+               || url.StartsWith("chrome://crash", StringComparison.OrdinalIgnoreCase));
